            <column caption='TTM Revenue' datatype='real' name='[TTM Revenue]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_SUM(SUM([revenue_usd]), -3, 0)' />
            </column>
    <column-instance column='[TTM Revenue]' derivation='User' name='[usr:TTM Revenue:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[display_name]' role='dimension' type='nominal' />
    <column-instance column='[display_name]' derivation='None' name='[none:display_name:nk]' pivot='key' type='nominal' />
