      <column datatype='string' name='[cik]' role='dimension' type='nominal' />
      <column datatype='integer' name='[fiscal_year]' role='dimension' type='ordinal' />
      <column datatype='string' name='[fiscal_quarter]' role='dimension' type='nominal' />
      <column datatype='integer' name='[year_ended]' role='dimension' type='ordinal' />
      <column datatype='date' name='[period_start]' role='dimension' type='ordinal' />
      <column datatype='date' name='[period_end]' role='dimension' type='ordinal' />
      <column datatype='integer' name='[days_in_period]' role='dimension' type='ordinal' />
      <column datatype='real' name='[revenue_usd]' default-format='$#,##0,,.0' role='measure' type='quantitative' />
      <column datatype='real' name='[cost_of_revenue_usd]' default-format='$#,##0,,.0' role='measure' type='quantitative' />
      <column datatype='real' name='[gross_profit_usd]' default-format='$#,##0,,.0' role='measure' type='quantitative' />
      <column datatype='real' name='[operating_income_usd]' default-format='$#,##0,,.0' role='measure' type='quantitative' />
      <column datatype='real' name='[net_income_usd]' default-format='$#,##0,,.0' role='measure' type='quantitative' />
      <column datatype='real' name='[operating_cash_flow_usd]' default-format='$#,##0,,.0' role='measure' type='quantitative' />
      <column datatype='string' name='[value_basis]' role='dimension' type='nominal' />
      <column datatype='string' name='[derivation]' role='dimension' type='nominal' />
      <column datatype='string' name='[gross_profit_method]' role='dimension' type='nominal' />
      <column datatype='string' name='[revenue_xbrl_tag]' role='dimension' type='nominal' />
      <column datatype='string' name='[cost_xbrl_tag]' role='dimension' type='nominal' />
      <column datatype='string' name='[gross_profit_xbrl_tag]' role='dimension' type='nominal' />
      <column datatype='string' name='[operating_income_xbrl_tag]' role='dimension' type='nominal' />
      <column datatype='string' name='[net_income_xbrl_tag]' role='dimension' type='nominal' />
      <column datatype='string' name='[ocf_xbrl_tag]' role='dimension' type='nominal' />
      <column datatype='string' name='[source_form]' role='dimension' type='nominal' />
      <column datatype='date' name='[filed_date]' role='dimension' type='ordinal' />
      <column datatype='string' name='[accession_number]' role='dimension' type='nominal' />
      <column datatype='string' name='[value_is_restated]' role='dimension' type='nominal' />
      <column datatype='string' name='[companyfacts_url]' role='dimension' type='nominal' />
      <column datatype='string' name='[filing_index_url]' role='dimension' type='nominal' />
      <column caption='YoY Revenue Growth %' datatype='real' name='[YoY Revenue Growth %]' role='measure' type='quantitative' default-format='0.0%'>
        <calculation class='tableau' formula='(ZN(SUM([revenue_usd])) - LOOKUP(ZN(SUM([revenue_usd])), -4)) / ABS(LOOKUP(ZN(SUM([revenue_usd])), -4))' />
      </column>
      <column caption='Gross Margin %' datatype='real' name='[Gross Margin %]' role='measure' type='quantitative' default-format='0.0%'>
        <calculation class='tableau' formula='SUM([gross_profit_usd]) / SUM([revenue_usd])' />
      </column>
      <column caption='Operating Margin %' datatype='real' name='[Operating Margin %]' role='measure' type='quantitative' default-format='0.0%'>
        <calculation class='tableau' formula='SUM([operating_income_usd]) / SUM([revenue_usd])' />
      </column>
      <column caption='Net Margin %' datatype='real' name='[Net Margin %]' role='measure' type='quantitative' default-format='0.0%'>
        <calculation class='tableau' formula='SUM([net_income_usd]) / SUM([revenue_usd])' />
      </column>
      <column caption='Margin Change bps' datatype='real' name='[Margin Change bps]' role='measure' type='quantitative' default-format='+#,##0;-#,##0'>
        <calculation class='tableau' formula='(ZN([Operating Margin %]) - LOOKUP(ZN([Operating Margin %]), -4)) * 10000' />
      </column>
      <column caption='TTM Revenue' datatype='real' name='[TTM Revenue]' role='measure' type='quantitative' default-format='$#,##0,,.0'>
        <calculation class='tableau' formula='WINDOW_SUM(SUM([revenue_usd]), -3, 0)' />
      </column>
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
    </datasource>
    <datasource caption='Company Directory' inline='true' name='federated.dim' version='18.1'>
