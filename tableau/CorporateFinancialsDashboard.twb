  <worksheets>
    <worksheet name='Revenue Trend'>
      <table>
        <view>
          <datasources>
            <datasource caption='Annual Financials' name='federated.annual' />
          </datasources>
          <datasource-dependencies datasource='federated.annual'>
            <column datatype='integer' name='[year_ended]' role='dimension' type='ordinal' />
    <column-instance column='[year_ended]' derivation='None' name='[none:year_ended:ok]' pivot='key' type='ordinal' />
            <column datatype='real' name='[revenue_usd]' role='measure' type='quantitative' />
    <column-instance column='[revenue_usd]' derivation='Sum' name='[sum:revenue_usd:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[display_name]' role='dimension' type='nominal' />
    <column-instance column='[display_name]' derivation='None' name='[none:display_name:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
            <filter class='categorical' column='[federated.annual].[none:display_name:nk]'>
              <groupfilter function='level-members' level='[none:display_name:nk]' />
            </filter>
            <slices>
              <column>[federated.annual].[none:display_name:nk]</column>
            </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
            <encodings>
              <color column='[federated.annual].[none:display_name:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.annual].[sum:revenue_usd:qk]</rows>
        <cols>[federated.annual].[none:year_ended:ok]</cols>
      </table>
    </worksheet>
    <worksheet name='YoY Revenue Growth'>
      <table>
        <view>
          <datasources>
            <datasource caption='Annual Financials' name='federated.annual' />
          </datasources>
          <datasource-dependencies datasource='federated.annual'>
            <column datatype='integer' name='[year_ended]' role='dimension' type='ordinal' />
    <column-instance column='[year_ended]' derivation='None' name='[none:year_ended:ok]' pivot='key' type='ordinal' />
            <column caption='YoY Revenue Growth %' datatype='real' name='[YoY Revenue Growth %]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([revenue_usd])) - LOOKUP(ZN(SUM([revenue_usd])), -1)) / ABS(LOOKUP(ZN(SUM([revenue_usd])), -1))' />
            </column>
    <column-instance column='[YoY Revenue Growth %]' derivation='User' name='[usr:YoY Revenue Growth %:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[display_name]' role='dimension' type='nominal' />
    <column-instance column='[display_name]' derivation='None' name='[none:display_name:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
            <filter class='categorical' column='[federated.annual].[none:display_name:nk]'>
              <groupfilter function='level-members' level='[none:display_name:nk]' />
            </filter>
            <slices>
              <column>[federated.annual].[none:display_name:nk]</column>
            </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.annual].[none:display_name:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.annual].[usr:YoY Revenue Growth %:qk]</rows>
        <cols>[federated.annual].[none:year_ended:ok]</cols>
      </table>
    </worksheet>
    <worksheet name='Gross Margin Trend'>
      <table>
        <view>
          <datasources>
            <datasource caption='Annual Financials' name='federated.annual' />
          </datasources>
          <datasource-dependencies datasource='federated.annual'>
