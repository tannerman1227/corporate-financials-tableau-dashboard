    <column-instance column='[revenue_usd]' derivation='Sum' name='[sum:revenue_usd:qk]' pivot='key' type='quantitative' />
            <column caption='Latest Year Flag' datatype='boolean' name='[Latest Year Flag]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[year_ended] = { FIXED [ticker] : MAX([year_ended]) }' />
            </column>
    <column-instance column='[Latest Year Flag]' derivation='None' name='[none:Latest Year Flag:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
